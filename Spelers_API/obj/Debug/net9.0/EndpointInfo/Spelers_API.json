{
  "openapi": "3.0.4",
  "info": {
    "title": "My API Spelers",
    "description": "An API to perform Speler operations",
    "termsOfService": "https://example.com/terms",
    "contact": {
      "name": "CDW",
      "url": "https://vives.be",
      "email": "wout.crevits@student.vives.be"
    },
    "license": {
      "name": "Speler API LICX",
      "url": "https://example.com/license"
    },
    "version": "v1"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Login"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Login"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Speler": {
      "get": {
        "tags": [
          "Speler"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpelerVM"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpelerVM"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpelerVM"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Speler"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpelerPostVM"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SpelerPostVM"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SpelerPostVM"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SpelerVM"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpelerVM"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpelerVM"
                }
              }
            }
          }
        }
      }
    },
    "/api/Speler/{id}": {
      "put": {
        "tags": [
          "Speler"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpelerPostVM"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SpelerPostVM"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SpelerPostVM"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Speler"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "confirmPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SpelerPostVM": {
        "type": "object",
        "properties": {
          "naam": {
            "type": "string",
            "nullable": true
          },
          "leeftijd": {
            "type": "integer",
            "format": "int32"
          },
          "positieId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "teamId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SpelerVM": {
        "type": "object",
        "properties": {
          "naam": {
            "type": "string",
            "nullable": true
          },
          "leeftijd": {
            "type": "integer",
            "format": "int32"
          },
          "positieNaam": {
            "type": "string",
            "nullable": true
          },
          "teamNaam": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme. Example: 'Bearer {token}'",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}